# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
PORT=3000

# Proveedor generativo: "anthropic" u "ollama"
# (si se omite: anthropic cuando exista ANTHROPIC_API_KEY, de lo contrario ollama)
LLM_PROVIDER=anthropic

# --- Anthropic API ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Tiempo máximo de espera al proveedor (ms)
LLM_TIMEOUT_MS=30000
